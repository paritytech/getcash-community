{
  "name": "getcash",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Buy CASH into your private Polkadot App funds",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && papi",
    "typecheck": "nuxt typecheck",
    "typecheck:packages": "tsc -p tsconfig.packages.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:worker": "esbuild worker/src/index.js --bundle --format=esm --platform=browser --outfile=worker/index.js --log-level=warning && mkdir -p public/worker && cp worker/index.js public/worker/index.js"
  },
  "dependencies": {
    "@chainflip/sdk": "^2.1.1",
    "@getsome/chainflip": "workspace:*",
    "@getsome/core": "workspace:*",
    "@getsome/ephemeral": "workspace:*",
    "@getsome/funding": "workspace:*",
    "@getsome/host": "workspace:*",
    "@getsome/meld": "workspace:*",
    "@getsome/people": "workspace:*",
    "@getsome/testing": "workspace:*",
    "@noble/hashes": "^2.2.0",
    "@novasamatech/host-api-wrapper": "^0.10.2",
    "@parity/product-sdk-host": "^0.15.1",
    "@pinia/nuxt": "^0.11.2",
    "@polkadot-api/descriptors": "file:.papi/descriptors",
    "@polkadot-labs/hdkd-helpers": "^0.0.27",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.2",
    "pinia": "^3.0.3",
    "polkadot-api": "2.2.2",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.6.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^3.2.6",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.10"
  },
  "pnpm": {
    "overrides": {
      "@polkadot-api/json-rpc-provider": "0.2.0"
    }
  }
}
