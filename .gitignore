# deps, including nested packages/*/node_modules
node_modules/

# build / test output (dist may be a symlink, hence both forms)
dist
dist/
coverage/
*.tsbuildinfo
.nuxt/
.output/
.data/

# polkadot-api: .papi/ is committed (polkadot-api.json, metadata/*.scale and
# descriptors/package.json); its nested .gitignore covers the generated dist/, which
# `postinstall: papi` rebuilds. Never hand-edit .papi/.

# env / secrets; .env.example documents the defaults
.env
.env.*
!.env.example

# editor / OS noise
.DS_Store
.idea/
.vscode/
*.log

# local-only agent settings
.claude/settings.local.json

# sale-vault (Hardhat) build output
packages/sale-vault/artifacts/
packages/sale-vault/cache/
packages/sale-vault/typechain-types/
packages/sale-vault/dist/
packages/sale-vault/coverage/
packages/sale-vault/coverage.json

# Worker bundle: generated by `pnpm build:worker` from worker/src.
worker/index.js
public/worker/

local/
