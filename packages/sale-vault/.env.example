# RPCs (public defaults are used when unset)
ARBITRUM_ONE_RPC=
ARBITRUM_SEPOLIA_RPC=

# Deploy: signing key and the roles baked into the contract. Never commit a real key.
DEPLOYER_KEY=
OPERATOR_ADDRESS=
ADMIN_ADDRESS=

# Arbiscan / Etherscan key for `hardhat verify`.
ARBISCAN_API_KEY=

# Fork test: set ARBITRUM_FORK=1 to fork Arbitrum One, a USDC-rich account to source real USDC from,
# and optionally a block to pin to.
ARBITRUM_FORK=
ARBITRUM_USDC_WHALE=
ARBITRUM_FORK_BLOCK=
