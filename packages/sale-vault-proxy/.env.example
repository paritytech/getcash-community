# RPCs (public defaults are used when unset or empty)
ARBITRUM_ONE_RPC=
ARBITRUM_SEPOLIA_RPC=

# Deploy: signing key, skim treasury and a guardian key of its own, never commit a real key
DEPLOYER_KEY=
TREASURY_ADDRESS=
GUARDIAN_ADDRESS=

# Arbiscan / Etherscan key for `hardhat verify`.
ARBISCAN_API_KEY=

# Arbitrum One fork, which test:fork and vectors set, optionally pinned to a block
ARBITRUM_FORK=
ARBITRUM_FORK_BLOCK=

