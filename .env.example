# Copy to .env and fill in. Never commit real values.
# Nuxt dev loads .env, not .env.local; for another file run `nuxi dev --dotenv <file>`.

# Demo faucet seed (12- or 24-word mnemonic or a 0x-prefixed 32-byte hex entropy value). The
# account funds the burner in the route's deposit asset, so it holds PAS and USDt on Asset Hub.
# Demo only: ships inside the client bundle. Use a dedicated, small, testnet-only account.
# The build refuses it unless packages/core/src/network.json marks the network as a testnet.
VITE_FAUCET_SEED=

VITE_DEPLOYER_SEED=

# Meld fiat on-ramp and off-ramp (card / bank): the backend adapter's URL and the dev product id
# sent as `x-dev-product-id` (must match the adapter's `allowed_products`). Not secrets. Unset, the
# offline fake client drives the demo, a sale included.
VITE_MELD_BASE_URL=
VITE_MELD_PRODUCT_ID=getcash.dev
# Card and bank sales: the off-ramp lanes this build sells through, best first, by asset id
# (`<asset>@<chain>`), never by Meld code: Meld's codes are the adapter's config (its `assets`
# block), read at runtime from GET /assets, so a Meld rename needs no change here. A sale takes the
# first lane the adapter's catalog routes for the seller's country and payout method, and falls
# through to the next when its providers do not quote. Unset: the direct Asset Hub sales only (USDT,
# then DOT). The Chainflip swap lanes are opt-in: append usdc@arbitrum and/or usdc@solana to sell
# through a swap where no direct route pays out. The adapter's supported.offramp_lanes must list a
# lane too; a region neither routes reads as not available there.
VITE_OFFRAMP_LANES=usdt@assethub,dot@assethub,usdc@arbitrum,usdc@solana

# Chainflip Broker-as-a-Service (chainflip-broker.io) API key, mainnet. Deposit channels open on
# its broker RPC, since Chainflip's backend refuses channels on its own default broker. BaaS calls
# the key the account's name rather than a secret; keep it out of the repo anyway. Unset, quotes
# and status still work and the crypto sources and withdrawal destinations show as not available.
VITE_CHAINFLIP_BROKER_API_KEY=

# Overrides the People network derived from the hostname (e.g. on localhost). Must match an
# adapter `auth.personhood.networks[].id`: previewnet | paseo-next-v2 | polkadot-test.
VITE_PERSONHOOD_NETWORK=
