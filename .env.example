# Copy to .env and fill in. Never commit real values.
# Nuxt dev loads .env, not .env.local; for another file run `nuxi dev --dotenv <file>`.

# Demo faucet seed (24-word mnemonic or a 0x-prefixed 32-byte hex entropy value).
# Demo only: ships inside the client bundle. Use a dedicated, small, testnet-only account.
VITE_FAUCET_SEED=

VITE_DEPLOYER_SEED=

# Meld fiat on-ramp (card / bank): the backend adapter's URL and the dev product id sent as
# `x-dev-product-id` (must match the adapter's `allowed_products`). Not secrets. Unset, the
# offline fake client drives the demo.
VITE_MELD_BASE_URL=
VITE_MELD_PRODUCT_ID=getcash.dev
