+func TestRotationInBacklog(t *testing.T) {
+	cases := []keyCase{
+		{"old key long before the rotation", keyA, 10, 0, true},
+		{"old key just before the rotation block", keyA, 19, 7, true},
+		{"old key earlier in the rotation block", keyA, 20, 1, true},
+		{"old key in the rotation transaction, key valid at its start", keyA, 20, 3, true},
+		{"old key after the rotation in the same block", keyA, 20, 4, false},
+		{"new key before the rotation in the same block", keyB, 20, 2, false},
+		{"new key after the rotation in the same block", keyB, 20, 5, true},
+		{"new key before the rotation block", keyB, 10, 1, false},
+		{"old key in a later block", keyA, 21, 0, false},
+		{"new key in a later block", keyB, 21, 1, true},
+		{"stranger after the rotation", other, 30, 1, false},
+	}
+	for _, reverse := range []bool{false, true} {
+		t.Run(fmt.Sprintf("reverse=%v", reverse), func(t *testing.T) {
+			w := newWorld(t)
+			w.rotate(20, 3, 0, w.keyB)
+			runKeyCases(t, w, cases, reverse)
+		})
+	}
+}
