+	r.deadNonces = store
+	hook := captureLogs(t)
+
+	scanPending := w.fromRouter(w.keyA, 10, 0)
+	catchUpOnly := w.fromRouter(w.keyA, 10, 1)
+	require.True(t, r.admitMessage(ctx, scanPending))
+	require.True(t, r.admitMessage(ctx, catchUpOnly), "catch-up answers for a nonce above the scan's ethNonce")
+
+	r.pruneDeferred([]uint64{scanPending.Nonce})
+
+	_, _, ok, err := r.checkV2Profitable(ctx, catchUpOnly, testInboundMsg(), "0xsource", 1_000_000)
+	require.NoError(t, err, "no upstream dead-letter path")
+	assert.False(t, ok)
+	assert.Equal(t, []string{eventOursDryRunFailed}, errorEvents(hook))
+	assert.False(t, r.deadNonces.IsDead(catchUpOnly.Nonce))
+}
