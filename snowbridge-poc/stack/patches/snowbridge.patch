+func (w *world) signTx(chainID *big.Int, key *ecdsa.PrivateKey) *ethtypes.Transaction {
+	w.nonce++
+	tx, err := ethtypes.SignTx(ethtypes.NewTx(&ethtypes.DynamicFeeTx{
+		ChainID:   chainID,
+		Nonce:     w.nonce,
+		GasFeeCap: big.NewInt(1),
+		GasTipCap: big.NewInt(1),
+		Gas:       21000,
+		To:        &testRouter,
+	}), ethtypes.LatestSignerForChainID(chainID), key)
+	require.NoError(w.t, err)
+	return tx
+}
+
+// message makes a Gateway event for a transaction at (block, txIndex) and registers the
+// transaction with the node. Positions must be unique within a test.
+func (w *world) message(origin common.Address, signer *ecdsa.PrivateKey, block uint64, txIndex uint) *contracts.GatewayOutboundMessageAccepted {
+	tx := w.signTx(testChainID, signer)
+	ev := &contracts.GatewayOutboundMessageAccepted{
+		Nonce: w.nonce,
+		Payload: contracts.Payload{
+			Origin:       origin,
+			Value:        big.NewInt(0),
+			ExecutionFee: big.NewInt(0),
+			RelayerFee:   big.NewInt(0),
+		},
+		Raw: ethtypes.Log{TxHash: tx.Hash(), BlockHash: blockHashOf(block), BlockNumber: block, TxIndex: txIndex},
+	}
+	w.place(ev, tx)
+	return ev
+}
+
+func (w *world) place(ev *contracts.GatewayOutboundMessageAccepted, tx *ethtypes.Transaction) {
+	w.chain.txs[txPos{blockHash: ev.Raw.BlockHash, index: ev.Raw.TxIndex}] = tx
+}
+
+func (w *world) fromRouter(signer *ecdsa.PrivateKey, block uint64, txIndex uint) *contracts.GatewayOutboundMessageAccepted {
+	return w.message(testRouter, signer, block, txIndex)
+}
