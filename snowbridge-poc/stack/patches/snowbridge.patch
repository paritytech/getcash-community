+// newBareWorld has no constructor log; newWorld has key A set at the registry's deploy block.
+func newBareWorld(t *testing.T) *world {
+	w := &world{t: t, keyA: newKey(t), keyB: newKey(t), keyC: newKey(t), other: newKey(t)}
+	w.chain = &fakeChain{txs: map[txPos]*ethtypes.Transaction{}}
