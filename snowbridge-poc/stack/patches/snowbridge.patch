+var (
+	testRouter   = common.HexToAddress("0x00000000000000000000000000000000000000a1")
+	testRouterV2 = common.HexToAddress("0x00000000000000000000000000000000000000a2")
+	testRegistry = common.HexToAddress("0x00000000000000000000000000000000000000b2")
+	testForeign  = common.HexToAddress("0x00000000000000000000000000000000000000c3")
+	testChainID  = big.NewInt(11155111)
+)
+
+type txPos struct {
+	blockHash common.Hash
+	index     uint
+}
+
+type fakeChain struct {
+	mu   sync.Mutex
+	txs  map[txPos]*ethtypes.Transaction
+	logs []ethtypes.Log
+
+	// looseFilter makes FilterLogs ignore the query, as a careless node might.
+	looseFilter bool
+	// mutateRPC edits the transaction JSON a node would return.
+	mutateRPC func(m map[string]any)
+
+	txErr  error
+	logErr error
+
+	txFetches int
+	queries   []goeth.FilterQuery
+}
+
+func blockHashOf(block uint64) common.Hash { return common.BigToHash(new(big.Int).SetUint64(block)) }
+
+func (c *fakeChain) CallContext(_ context.Context, result interface{}, method string, args ...interface{}) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if method != "eth_getTransactionByBlockHashAndIndex" {
+		return fmt.Errorf("unexpected method %s", method)
+	}
+	c.txFetches++
+	if c.txErr != nil {
+		return c.txErr
+	}
+	pos := txPos{blockHash: args[0].(common.Hash), index: uint(args[1].(hexutil.Uint))}
+	out := result.(*json.RawMessage)
+	tx, ok := c.txs[pos]
+	if !ok {
+		*out = json.RawMessage("null")
+		return nil
+	}
+	encoded, err := tx.MarshalJSON()
+	if err != nil {
+		return err
+	}
+	var m map[string]any
+	if err := json.Unmarshal(encoded, &m); err != nil {
+		return err
+	}
+	m["blockHash"] = pos.blockHash
+	m["transactionIndex"] = hexutil.Uint(pos.index)
+	if c.mutateRPC != nil {
+		c.mutateRPC(m)
+	}
+	*out, err = json.Marshal(m)
+	return err
+}
+
+func (c *fakeChain) FilterLogs(_ context.Context, q goeth.FilterQuery) ([]ethtypes.Log, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.queries = append(c.queries, q)
+	if c.logErr != nil {
+		return nil, c.logErr
+	}
+	var out []ethtypes.Log
+	for _, l := range c.logs {
+		if !c.looseFilter {
+			if l.BlockNumber < q.FromBlock.Uint64() || l.BlockNumber > q.ToBlock.Uint64() {
+				continue
+			}
+			if len(q.Addresses) == 1 && l.Address != q.Addresses[0] {
+				continue
+			}
+			if len(q.Topics) == 1 && !slices.Contains(q.Topics[0], l.Topics[0]) {
+				continue
+			}
+		}
+		out = append(out, l)
+	}
+	return out, nil
+}
