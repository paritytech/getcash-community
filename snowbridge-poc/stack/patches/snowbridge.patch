+func errorEvents(hook *logtest.Hook) []string {
+	var out []string
+	for _, e := range hook.AllEntries() {
+		if e.Level == log.ErrorLevel {
+			if event, ok := e.Data["event"].(string); ok {
+				out = append(out, event)
+			}
+		}
+	}
+	return out
+}
