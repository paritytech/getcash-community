+// rotate records a RelayerChanged log; logs are appended in call order, not sorted.
+func (w *world) rotate(block uint64, txIndex, logIndex uint, to *ecdsa.PrivateKey) {
+	w.rotateTo(block, txIndex, logIndex, addr(to))
+}
+
+func (w *world) rotateTo(block uint64, txIndex, logIndex uint, to common.Address) {
+	w.chain.logs = append(w.chain.logs, ethtypes.Log{
+		Address:     testRegistry,
+		Topics:      []common.Hash{relayerChangedTopic},
+		Data:        common.LeftPadBytes(to.Bytes(), 32),
+		BlockNumber: block,
+		TxIndex:     txIndex,
+		Index:       logIndex,
+	})
+}
