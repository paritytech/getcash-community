diff --git a/relayer/relays/ethereum-v3/ours.go b/relayer/relays/ethereum-v3/ours.go
new file mode 100644
index 00000000..ddf91307
--- /dev/null
+++ b/relayer/relays/ethereum-v3/ours.go
@@ -0,0 +1,436 @@
+package executionV3
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/big"
+	"sort"
+	"sync"
+
+	goeth "github.com/ethereum/go-ethereum"
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/common/hexutil"
+	ethtypes "github.com/ethereum/go-ethereum/core/types"
+	"github.com/ethereum/go-ethereum/crypto"
+	log "github.com/sirupsen/logrus"
+	"github.com/snowfork/snowbridge/relayer/chain/parachain"
+	"github.com/snowfork/snowbridge/relayer/contracts"
+	"github.com/snowfork/snowbridge/relayer/relays/error_tracking"
+	"github.com/snowfork/snowbridge/relayer/relays/gasestimator"
+)
+
+const (
+	eventOursCheckFailed    = "getcash_ours_check_failed"
+	eventOursDryRunFailed   = "getcash_ours_dry_run_failed"
+	eventOursCandidateError = "getcash_ours_candidate_error"
+
+	defaultRegistryLogChunk = 10_000
+)
+
+var relayerChangedTopic = crypto.Keccak256Hash([]byte("RelayerChanged(address)"))
+
+// GetcashConfig switches the "ours only" mode: deliver only messages a router sent in a
+// transaction signed by the registry's trigger key, and skip every other message.
+type GetcashConfig struct {
+	Enabled  bool   `mapstructure:"enabled"`
+	Registry string `mapstructure:"registry"`
+	// One router per forwarder version.
+	Routers []string `mapstructure:"routers"`
+	// The block that deployed the registry. Its constructor must have emitted RelayerChanged.
+	RegistryDeployBlock uint64 `mapstructure:"registry-deploy-block"`
+	// Blocks per getLogs request when reading the key history. Zero means 10000.
+	RegistryLogChunk uint64 `mapstructure:"registry-log-chunk"`
+}
+
+func (c GetcashConfig) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+	if err := requireAddress("registry", c.Registry); err != nil {
+		return err
+	}
+	if len(c.Routers) == 0 {
+		return fmt.Errorf("getcash setting [routers] is empty")
+	}
+	for _, router := range c.Routers {
+		if err := requireAddress("routers", router); err != nil {
+			return err
+		}
+	}
+	if c.RegistryDeployBlock == 0 {
+		return fmt.Errorf("getcash setting [registry-deploy-block] is not set")
+	}
+	return nil
+}
+
+// validateGetcash also rejects V1: its messages carry no router origin, so none is ours.
+func (c Config) validateGetcash() error {
+	if err := c.Getcash.Validate(); err != nil {
+		return fmt.Errorf("getcash config: %w", err)
+	}
+	if c.Getcash.Enabled && c.V1Enabled() {
+		return fmt.Errorf("getcash config: source channel-id must be empty, V1 messages are never ours")
+	}
+	return nil
+}
+
+func requireAddress(name, value string) error {
+	if !common.IsHexAddress(value) {
+		return fmt.Errorf("getcash setting [%s] is not a hex address: %q", name, value)
+	}
+	if common.HexToAddress(value) == (common.Address{}) {
+		return fmt.Errorf("getcash setting [%s] is the zero address", name)
+	}
+	return nil
+}
+
+type oursChain interface {
+	CallContext(ctx context.Context, result interface{}, method string, args ...interface{}) error
+	FilterLogs(ctx context.Context, q goeth.FilterQuery) ([]ethtypes.Log, error)
+}
+
+type keyChange struct {
+	block    uint64
+	txIndex  uint
+	logIndex uint
+	key      common.Address
+}
+
+func (c keyChange) before(o keyChange) bool {
+	if c.block != o.block {
+		return c.block < o.block
+	}
+	if c.txIndex != o.txIndex {
+		return c.txIndex < o.txIndex
+	}
+	return c.logIndex < o.logIndex
+}
+
+// appliesTo is true when the change took effect before the transaction started, so a
+// rotation and a transaction in the same block are ordered by transaction index.
+func (c keyChange) appliesTo(block uint64, txIndex uint) bool {
+	return c.block < block || (c.block == block && c.txIndex < txIndex)
+}
+
+type oursFilter struct {
+	registry    common.Address
+	routers     map[common.Address]struct{}
+	deployBlock uint64
+	chain       oursChain
+	chainID     *big.Int
+	logChunk    uint64
+
+	historyMu sync.Mutex
+	changes   []keyChange
+	nextBlock uint64 // first block whose RelayerChanged logs are not in changes yet
+
+	verdictsMu sync.Mutex
+	verdicts   map[uint64]bool // by nonce; only answers that came without an error
+}
+
+func newOursFilter(cfg GetcashConfig, chain oursChain, chainID *big.Int) *oursFilter {
+	f := &oursFilter{
+		registry:    common.HexToAddress(cfg.Registry),
+		routers:     make(map[common.Address]struct{}, len(cfg.Routers)),
+		deployBlock: cfg.RegistryDeployBlock,
+		chain:       chain,
+		chainID:     chainID,
+		logChunk:    cfg.RegistryLogChunk,
+		nextBlock:   cfg.RegistryDeployBlock,
+		verdicts:    make(map[uint64]bool),
+	}
+	if f.logChunk == 0 {
+		f.logChunk = defaultRegistryLogChunk
+	}
+	for _, router := range cfg.Routers {
+		f.routers[common.HexToAddress(router)] = struct{}{}
+	}
+	return f
+}
+
+// isOurs reports whether the message is ours. Any error counts as not ours and is not
+// remembered. Both answers that come without an error are final: the message is finalized
+// and the key history only grows.
+func (f *oursFilter) isOurs(ctx context.Context, ev *contracts.GatewayOutboundMessageAccepted) bool {
+	f.verdictsMu.Lock()
+	ours, known := f.verdicts[ev.Nonce]
+	f.verdictsMu.Unlock()
+	if known {
+		return ours
+	}
+	ours, err := f.verdict(ctx, ev)
+	if err != nil {
+		log.WithError(err).WithFields(log.Fields{
+			"event": eventOursCheckFailed,
+			"nonce": ev.Nonce,
+			"tx":    ev.Raw.TxHash.Hex(),
+		}).Warn("[getcash] could not tell whether the message is ours; treating it as not ours this round")
+		return false
+	}
+	f.verdictsMu.Lock()
+	f.verdicts[ev.Nonce] = ours
+	f.verdictsMu.Unlock()
+	return ours
+}
+
+func (f *oursFilter) isOur(nonce uint64) bool {
+	f.verdictsMu.Lock()
+	defer f.verdictsMu.Unlock()
+	return f.verdicts[nonce]
+}
+
+// forgetSettled drops the answers for nonces that are no longer pending. Only nonces at or
+// below the highest pending one are judged: a concurrent scan with a newer view may have
+// answered for nonces above it, and those must survive while they are pending.
+func (f *oursFilter) forgetSettled(pending []uint64) {
+	if len(pending) == 0 {
+		return
+	}
+	keep := make(map[uint64]struct{}, len(pending))
+	highest := pending[0]
+	for _, n := range pending {
+		keep[n] = struct{}{}
+		highest = max(highest, n)
+	}
+	f.verdictsMu.Lock()
+	defer f.verdictsMu.Unlock()
+	for n := range f.verdicts {
+		if _, ok := keep[n]; !ok && n <= highest {
+			delete(f.verdicts, n)
+		}
+	}
+}
+
+func (f *oursFilter) verdict(ctx context.Context, ev *contracts.GatewayOutboundMessageAccepted) (bool, error) {
+	if _, ok := f.routers[ev.Payload.Origin]; !ok {
+		return false, nil
+	}
+	tx, err := f.transactionAt(ctx, ev)
+	if err != nil {
+		return false, err
+	}
+	signer, err := ethtypes.Sender(ethtypes.LatestSignerForChainID(f.chainID), tx)
+	if err != nil {
+		return false, fmt.Errorf("recover transaction signer: %w", err)
+	}
+	key, found, err := f.triggerKeyAt(ctx, ev.Raw.BlockNumber, ev.Raw.TxIndex)
+	if err != nil {
+		return false, err
+	}
+	return found && key != (common.Address{}) && signer == key, nil
+}
+
+// transactionAt fetches the transaction by its position in the log's block, not by hash, and
+// requires it to be the log's transaction. That ties the recovered signer to the receipt
+// Bridge Hub verifies.
+func (f *oursFilter) transactionAt(ctx context.Context, ev *contracts.GatewayOutboundMessageAccepted) (*ethtypes.Transaction, error) {
+	var raw json.RawMessage
+	err := f.chain.CallContext(ctx, &raw, "eth_getTransactionByBlockHashAndIndex", ev.Raw.BlockHash, hexutil.Uint(ev.Raw.TxIndex))
+	if err != nil {
+		return nil, fmt.Errorf("fetch transaction by position: %w", err)
+	}
+	if len(raw) == 0 || string(raw) == "null" {
+		return nil, errors.New("no transaction at the log's position")
+	}
+	var tx ethtypes.Transaction
+	var pos struct {
+		BlockHash *common.Hash  `json:"blockHash"`
+		Index     *hexutil.Uint `json:"transactionIndex"`
+	}
+	if err := json.Unmarshal(raw, &tx); err != nil {
+		return nil, fmt.Errorf("decode transaction: %w", err)
+	}
+	if err := json.Unmarshal(raw, &pos); err != nil {
+		return nil, fmt.Errorf("decode transaction position: %w", err)
+	}
+	if pos.BlockHash == nil || *pos.BlockHash != ev.Raw.BlockHash || pos.Index == nil || uint(*pos.Index) != ev.Raw.TxIndex {
+		return nil, errors.New("transaction is not at the log's position")
+	}
+	if tx.Hash() != ev.Raw.TxHash {
+		return nil, fmt.Errorf("transaction at the log's position is %s, not %s", tx.Hash().Hex(), ev.Raw.TxHash.Hex())
+	}
+	return &tx, nil
+}
+
+// triggerKeyAt returns the registry's trigger key as it stood when the transaction at
+// (block, txIndex) started. found is false before the constructor's RelayerChanged log.
+func (f *oursFilter) triggerKeyAt(ctx context.Context, block uint64, txIndex uint) (key common.Address, found bool, err error) {
+	f.historyMu.Lock()
+	defer f.historyMu.Unlock()
+
+	if block < f.deployBlock {
+		return common.Address{}, false, nil
+	}
+	if err := f.refreshLocked(ctx, block); err != nil {
+		return common.Address{}, false, err
+	}
+	for _, c := range f.changes {
+		if !c.appliesTo(block, txIndex) {
+			break
+		}
+		key, found = c.key, true
+	}
+	return key, found, nil
+}
+
+// refreshLocked reads the RelayerChanged logs up to and including upTo. A failed chunk
+// leaves the history as it was, so the next call retries from the same block.
+func (f *oursFilter) refreshLocked(ctx context.Context, upTo uint64) error {
+	for f.nextBlock <= upTo {
+		end := min(f.nextBlock+f.logChunk-1, upTo)
+		changes, err := f.registryChanges(ctx, f.nextBlock, end)
+		if err != nil {
+			return err
+		}
+		f.changes = append(f.changes, changes...)
+		f.nextBlock = end + 1
+	}
+	return nil
+}
+
+// registryChanges returns the registry's RelayerChanged logs in [from, to], ordered. Logs
+// that are not from the registry, not that event, or outside the range are ignored; a log
+// that is the event but not the expected shape is an error, since the history cannot be trusted.
+func (f *oursFilter) registryChanges(ctx context.Context, from, to uint64) ([]keyChange, error) {
+	logs, err := f.chain.FilterLogs(ctx, goeth.FilterQuery{
+		FromBlock: new(big.Int).SetUint64(from),
+		ToBlock:   new(big.Int).SetUint64(to),
+		Addresses: []common.Address{f.registry},
+		Topics:    [][]common.Hash{{relayerChangedTopic}},
+	})
+	if err != nil {
+		return nil, fmt.Errorf("query RelayerChanged logs %d-%d: %w", from, to, err)
+	}
+	changes := make([]keyChange, 0, len(logs))
+	for _, l := range logs {
+		if l.Address != f.registry || len(l.Topics) == 0 || l.Topics[0] != relayerChangedTopic || l.BlockNumber < from || l.BlockNumber > to {
+			continue
+		}
+		if len(l.Topics) != 1 || len(l.Data) != 32 {
+			return nil, fmt.Errorf("malformed RelayerChanged log in transaction %s", l.TxHash.Hex())
+		}
+		changes = append(changes, keyChange{block: l.BlockNumber, txIndex: l.TxIndex, logIndex: l.Index, key: common.BytesToAddress(l.Data)})
+	}
+	sort.SliceStable(changes, func(i, j int) bool { return changes[i].before(changes[j]) })
+	return changes, nil
+}
+
+// verifyRegistry fails when the registry did not emit RelayerChanged at the deploy block,
+// which means the address or block is wrong or the registry has no constructor event.
+func (f *oursFilter) verifyRegistry(ctx context.Context) error {
+	changes, err := f.registryChanges(ctx, f.deployBlock, f.deployBlock)
+	if err != nil {
+		return err
+	}
+	if len(changes) == 0 {
+		return fmt.Errorf("no RelayerChanged log from registry %s at registry-deploy-block %d", f.registry.Hex(), f.deployBlock)
+	}
+	return nil
+}
+
+func (r *Relay) startOursFilter(ctx context.Context, chain oursChain) error {
+	cfg := r.config.Getcash
+	if !cfg.Enabled {
+		return nil
+	}
+	f := newOursFilter(cfg, chain, r.chainID)
+	if err := f.verifyRegistry(ctx); err != nil {
+		return fmt.Errorf("getcash registry check: %w", err)
+	}
+	r.ours = f
+	log.WithFields(log.Fields{
+		"registry":            cfg.Registry,
+		"routers":             cfg.Routers,
+		"registryDeployBlock": cfg.RegistryDeployBlock,
+	}).Info("[getcash] ours-only mode: delivering only router messages signed by the trigger key")
+	return nil
+}
+
+// admitMessage is the screening step for a V2 message. With the mode off it admits
+// everything, as upstream does. With it on, only our messages pass, and the answer is kept
+// so the fee and profitability gates let them through.
+func (r *Relay) admitMessage(ctx context.Context, ev *contracts.GatewayOutboundMessageAccepted) bool {
+	if r.ours == nil {
+		return true
+	}
+	if !r.ours.isOurs(ctx, ev) {
+		log.WithField("nonce", ev.Nonce).Debug("[getcash] not ours; skipping")
+		return false
+	}
+	return true
+}
+
+func (r *Relay) isOurMessage(ev *contracts.GatewayOutboundMessageAccepted) bool {
+	return r.ours != nil && ev != nil && r.ours.isOur(ev.Nonce)
+}
+
+func (r *Relay) forgetOurNonces(pending []uint64) {
+	if r.ours != nil {
+		r.ours.forgetSettled(pending)
+	}
+}
+
+// priceOurMessage replaces the profitability gate for our messages. They are never priced
+// out; a failing Asset Hub dry-run keeps the message pending and raises an alert instead
+// of dead-lettering it.
+func (r *Relay) priceOurMessage(
+	ctx context.Context,
+	ev *contracts.GatewayOutboundMessageAccepted,
+	inboundMsg *parachain.MessageV3,
+	source string,
+) ([]string, *v2Economics, bool, error) {
+	if !r.gasEstimator.Enabled() {
+		return nil, ourEconomics(ev), true, nil
+	}
+	estimate, err := r.gasEstimator.EstimateGas(ctx, ev, inboundMsg, source, r.keypair.PublicKey())
+	return r.judgeOurEstimate(ev, estimate, err)
+}
+
+func (r *Relay) judgeOurEstimate(
+	ev *contracts.GatewayOutboundMessageAccepted,
+	estimate *gasestimator.GasEstimate,
+	err error,
+) ([]string, *v2Economics, bool, error) {
+	if err != nil {
+		if error_tracking.IsTransientError(err) {
+			return nil, nil, false, fmt.Errorf("gas estimation: %w", err)
+		}
+		alertOurs(eventOursDryRunFailed, ev.Nonce, fmt.Sprintf("gas estimator failed: %v", err))
+		return nil, nil, false, nil
+	}
+	if !estimate.AssetHubAccepted() {
+		reason := "Asset Hub dry-run failed"
+		if estimate != nil {
+			reason += ": " + gasEstimateErr(estimate.AssetHubDryRunError)
+		}
+		alertOurs(eventOursDryRunFailed, ev.Nonce, reason)
+		return nil, nil, false, nil
+	}
+	return estimate.Beneficiaries, ourEconomics(ev), true, nil
+}
+
+// ourEconomics marks the message as past its max delay, which the batch gate keeps even
+// when the batch does not pay for itself.
+func ourEconomics(ev *contracts.GatewayOutboundMessageAccepted) *v2Economics {
+	return &v2Economics{nonce: ev.Nonce, pastMaxDelay: true}
+}
+
+// alertOurCandidateError reports whether err was handled for one of our messages: it is
+// alerted and the nonce stays pending instead of being dead-lettered.
+func (r *Relay) alertOurCandidateError(nonce uint64, err error) bool {
+	if r.ours == nil || !r.ours.isOur(nonce) {
+		return false
+	}
+	alertOurs(eventOursCandidateError, nonce, err.Error())
+	return true
+}
+
+func alertOurs(event string, nonce uint64, reason string) {
+	log.WithFields(log.Fields{
+		"event":  event,
+		"nonce":  nonce,
+		"reason": reason,
+	}).Error("[getcash] our message needs attention; it stays pending and is retried")
+}
