+type keyCase struct {
+	name   string
+	signer func(w *world) *ecdsa.PrivateKey
+	block  uint64
+	tx     uint
+	ours   bool
+}
+
+func runKeyCases(t *testing.T, w *world, cases []keyCase, reverse bool) {
+	t.Helper()
+	events := make([]*contracts.GatewayOutboundMessageAccepted, len(cases))
+	for i, c := range cases {
+		events[i] = w.fromRouter(c.signer(w), c.block, c.tx)
+	}
+	order := make([]int, len(cases))
+	for i := range order {
+		order[i] = i
+		if reverse {
+			order[i] = len(cases) - 1 - i
+		}
+	}
+	for _, i := range order {
+		assert.Equal(t, cases[i].ours, w.filter.isOurs(context.Background(), events[i]), cases[i].name)
+	}
+}
