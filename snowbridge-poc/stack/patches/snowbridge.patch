+// The worker scan prunes with the pending set of its older view while catch-up, under the same
+// read lock, has just answered for a newer nonce. The answer must survive, or catch-up prices
+// our message by the upstream path and can dead-letter it.
+func TestScanPruneDoesNotStripCatchUpsAnswerBeforePricing(t *testing.T) {
+	t.Setenv("PROFITABILITY_MAX_DELAY_SECS", "0")
