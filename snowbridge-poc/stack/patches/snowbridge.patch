+// The scan loops cannot run without a Bridge Hub connection, so this pins their shape: a message
+// that is not ours is skipped by an `if !r.admitMessage(...) { continue }` before it can become a
+// candidate, which is what keeps it away from buildCandidate (beacon proofs, includeBeacon) and
+// handleCandidateError.
+func TestNotOursIsSkippedBeforeAnyCandidateWork(t *testing.T) {
+	for _, tt := range []struct{ file, fn string }{
+		{"main.go", "doScanAndBatchRelay"},
+		{"catchup.go", "collectV2ForCatchUp"},
+	} {
+		t.Run(tt.fn, func(t *testing.T) {
+			fset := token.NewFileSet()
+			file, err := parser.ParseFile(fset, tt.file, nil, 0)
+			require.NoError(t, err)
+
+			var fn *ast.FuncDecl
+			for _, d := range file.Decls {
+				if f, ok := d.(*ast.FuncDecl); ok && f.Name.Name == tt.fn {
+					fn = f
+				}
+			}
+			require.NotNil(t, fn)
+
+			var gate token.Pos
+			var firstCandidateWork token.Pos
+			ast.Inspect(fn.Body, func(n ast.Node) bool {
+				switch n := n.(type) {
+				case *ast.IfStmt:
+					not, ok := n.Cond.(*ast.UnaryExpr)
+					if !ok || not.Op != token.NOT || len(n.Body.List) != 1 {
+						return true
+					}
+					call, ok := not.X.(*ast.CallExpr)
+					branch, isBranch := n.Body.List[0].(*ast.BranchStmt)
+					if ok && isBranch && branch.Tok == token.CONTINUE && selectorName(call) == "admitMessage" {
+						gate = n.Pos()
+					}
+				case *ast.CallExpr:
+					switch selectorName(n) {
+					case "buildCandidate", "handleCandidateError":
+						if firstCandidateWork == 0 || n.Pos() < firstCandidateWork {
+							firstCandidateWork = n.Pos()
+						}
+					}
+				}
+				return true
+			})
+			require.NotZero(t, gate, "the admitMessage gate is missing")
+			require.NotZero(t, firstCandidateWork)
+			assert.Less(t, int(gate), int(firstCandidateWork), "the gate must come before any candidate work")
+		})
+	}
+}
+
+func selectorName(call *ast.CallExpr) string {
+	if sel, ok := call.Fun.(*ast.SelectorExpr); ok {
+		return sel.Sel.Name
+	}
+	return ""
+}
