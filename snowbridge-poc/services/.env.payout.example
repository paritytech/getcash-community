# Payout service. Copy to .env.payout (gitignored) and fill in; a dev seed only, never a real one.
# The service reads .env.payout, or the file named by PAYOUT_ENV_FILE, and takes only the variables below from it,
# so the trigger key can never reach this process. The trigger service has its own file (.env.example).

ETHEREUM_RPC_URL=http://127.0.0.1:8545
ASSET_HUB_WS=ws://127.0.0.1:12144
ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
POOL_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# 0x-prefixed 32-byte hex seed or a substrate URI; the payer's Asset Hub account is derived with sr25519.
PAYER_SEED=
# Required on a first start, and again whenever the state file is lost: the first Ethereum block to scan.
# The router's deploy block rebuilds everything the pool still attributes to this payer.
START_BLOCK=

CONFIRMATIONS=2
FRONT_FEE_BPS=10
# Token base units: the largest payout of one front, and the most that may be fronted and unsettled at once.
MAX_PER_DEPOSIT=
MAX_OUTSTANDING=
POLL_INTERVAL_MS=1000
MAX_ATTEMPTS=3
RETRY_DELAY_MS=5000
# A deposit that gave up on transport errors is queued again after this long, on the next pass without errors.
FAILED_RETRY_MS=60000
# How long a front waits for inclusion before it is treated as lost and the chain is read again.
SUBMIT_TIMEOUT_MS=60000
# Error alert for a fronted deposit still unsettled this long after its Ethereum block was finalized; 0 turns it off.
UNSETTLED_ALERT_MINUTES=30
STATE_FILE=data/payout-state.json
HTTP_HOST=127.0.0.1
HTTP_PORT=8788
PAYOUT_ENV_FILE=.env.payout
