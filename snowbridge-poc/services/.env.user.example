# User stand-in CLI (pnpm user ...). Copy to .env.user (gitignored).
# The CLI reads .env.user, or the file named by USER_ENV_FILE, then falls back to .env; it takes only the variables below
# from either, so the trigger key and the payer seed never reach it.

# Any string; the owner key and the Asset Hub account derive from it.
USER_SEED=
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
RPC_URL=http://127.0.0.1:8545
TRIGGER_URL=http://127.0.0.1:8787
